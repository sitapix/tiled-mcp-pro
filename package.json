{
  "name": "tiled-mcp-pro",
  "version": "0.1.0",
  "description": "A safety-first MCP server for inspecting and editing Tiled maps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitapix/tiled-mcp-pro.git"
  },
  "homepage": "https://github.com/sitapix/tiled-mcp-pro#readme",
  "bugs": {
    "url": "https://github.com/sitapix/tiled-mcp-pro/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "tiled",
    "tilemap",
    "tmx",
    "tmj",
    "map-editor",
    "gamedev"
  ],
  "type": "module",
  "bin": {
    "tiled-mcp-pro": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "contract:check": "tsx scripts/generate-mcp-contract.ts --check",
    "contract:generate": "tsx scripts/generate-mcp-contract.ts --write",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm run verify",
    "pretest": "pnpm run contract:check && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest --exclude tests/stdio.test.ts",
    "test:stdio": "pnpm run build && vitest run tests/stdio.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run contract:check && vitest run",
    "verify:tiled-1.12.2": "tsx scripts/verify-tiled-1.12.2.ts"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "jsonc-parser": "3.3.1",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mapeditor/tiled-api": "^1.12.0",
    "@types/node": "26.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
